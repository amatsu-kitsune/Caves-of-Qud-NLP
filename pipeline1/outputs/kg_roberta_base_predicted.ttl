@prefix qud: <http://www.semanticweb.org/chris/ontologies/caverne-di-qud#> .

qud:Golgotha a qud:Place ;
    qud:hostsQuest qud:More_Than_a_Willing_Spirit .

qud:Baetyl a qud:NPC,
        qud:Robot ;
    qud:isHabitantOf qud:Temple_of_the_Rock .

qud:Bethesda_Susa a qud:Place ;
    qud:hasInhabitant qud:alchemist .

qud:Fighter_Boss a qud:Fighter .

qud:Fighter_NonBoss a qud:Fighter .

qud:Joppa a qud:Settlement ;
    qud:hasInhabitant qud:Argyve .

qud:Mutated_Human a qud:Race ;
    qud:hasIndividual qud:Phinae_Hoshaiah_High_Priest_of_the_Rock .

qud:Sentient_Plant a qud:Race ;
    qud:hasIndividual qud:Asphodel_Earl_of_Omonporch .

qud:Starformed_Ehalcodon a qud:Mutant,
        qud:NPC .

qud:The_Golem a qud:Quest ;
    qud:requiresCompleting qud:Reclamation .

qud:Trader_high a qud:Trader .

qud:alchemist a qud:Mutant,
        qud:NPC ;
    qud:hasRole qud:Fighter_NonBoss,
        qud:Trader_high ;
    qud:isHabitantOf qud:Bethesda_Susa .

qud:Asphodel_Earl_of_Omonporch a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Sentient_Plant ;
    qud:isHabitantOf qud:Omonporch .

qud:Fungi a qud:Race ;
    qud:hasIndividual qud:Barathrum_the_Old,
        qud:Pax_Qlanq .

qud:Golem a qud:Mutant,
        qud:NPC .

qud:Pax_Qlanq a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Fungi ;
    qud:isHabitantOf qud:Rainbow_Wood .

qud:Rainbow_Wood a qud:Place ;
    qud:hasInhabitant qud:Barathrum_the_Old,
        qud:Pax_Qlanq .

qud:Reseph a qud:NPC,
        qud:Robot ;
    qud:isHabitantOf qud:Omonporch,
        qud:Starfarers_Quay .

qud:Sparafucile a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Urshiib ;
    qud:isHabitantOf qud:Grit_Gate .

qud:Starfarers_Quay a qud:Place ;
    qud:hasInhabitant qud:Barathrum_the_Old,
        qud:Reseph .

qud:We_Are_Starfreight a qud:Quest ;
    qud:requiresCompleting qud:Reclamation .

qud:Argyve a qud:Mutant,
        qud:NPC ;
    qud:isHabitantOf qud:Grit_Gate,
        qud:Joppa .

qud:Mechanimists a qud:Faction ;
    qud:foughtIn qud:Decoding_the_Signal ;
    qud:hasMember qud:Golem,
        qud:Phinae_Hoshaiah_High_Priest_of_the_Rock ;
    qud:hates qud:Barathrumites,
        qud:Girsh,
        qud:Mechanimists .

qud:Omonporch a qud:Place ;
    qud:hasInhabitant qud:Asphodel_Earl_of_Omonporch,
        qud:Barathrum_the_Old,
        qud:Reseph .

qud:Otho a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Urshiib ;
    qud:isHabitantOf qud:Grit_Gate ;
    qud:memberOf qud:Barathrumites .

qud:Phinae_Hoshaiah_High_Priest_of_the_Rock a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Mutated_Human ;
    qud:hasRole qud:Fighter_Boss ;
    qud:isHabitantOf qud:Temple_of_the_Rock .

qud:Robot a qud:Race .

qud:Temple_of_the_Rock a qud:Settlement ;
    qud:hasInhabitant qud:Baetyl,
        qud:Phinae_Hoshaiah_High_Priest_of_the_Rock .

qud:Urshiib a qud:Race ;
    qud:hasIndividual qud:Barathrum_the_Old,
        qud:Otho,
        qud:Sparafucile .

qud:Girsh a qud:Faction ;
    qud:foughtIn qud:Reclamation ;
    qud:hasMember qud:Starformed_Ehalcodon ;
    qud:hates qud:Barathrumites,
        qud:Mechanimists,
        qud:Putus_Templar .

qud:More_Than_a_Willing_Spirit a qud:Quest ;
    qud:requiresCompleting qud:A_Canticle_for_Barathrum,
        qud:Decoding_the_Signal .

qud:Putus_Templar a qud:Faction ;
    qud:foughtIn qud:A_Call_to_Arms,
        qud:The_Earl_of_Omonporch ;
    qud:hates qud:Barathrumites,
        qud:Girsh .

qud:Reclamation a qud:Quest ;
    qud:involvesFightWith qud:Girsh ;
    qud:requiresCompleting qud:The_Golem,
        qud:We_Are_Starfreight .

qud:Barathrumites a qud:Faction ;
    qud:foughtIn qud:A_Call_to_Arms,
        qud:A_Canticle_for_Barathrum,
        qud:Decoding_the_Signal,
        qud:More_Than_a_Willing_Spirit,
        qud:The_Earl_of_Omonporch ;
    qud:hasMember qud:Argyve,
        qud:Barathrum_the_Old,
        qud:Golem,
        qud:Otho ;
    qud:hates qud:Barathrumites,
        qud:Girsh,
        qud:Mechanimists,
        qud:Putus_Templar .

qud:Grit_Gate a qud:Settlement ;
    qud:hasInhabitant qud:Argyve,
        qud:Barathrum_the_Old,
        qud:Otho,
        qud:Sparafucile ;
    qud:hostsQuest qud:A_Call_to_Arms,
        qud:A_Canticle_for_Barathrum,
        qud:Decoding_the_Signal,
        qud:Reclamation,
        qud:The_Earl_of_Omonporch,
        qud:We_Are_Starfreight .

qud:The_Earl_of_Omonporch a qud:Quest ;
    qud:involvesFightWith qud:Putus_Templar ;
    qud:requiresCompleting qud:A_Call_to_Arms,
        qud:A_Canticle_for_Barathrum,
        qud:Decoding_the_Signal .

qud:A_Call_to_Arms a qud:Quest ;
    qud:involvesFightWith qud:Putus_Templar ;
    qud:requiresCompleting qud:A_Canticle_for_Barathrum,
        qud:Decoding_the_Signal,
        qud:The_Earl_of_Omonporch ;
    qud:takesPlaceIn qud:Grit_Gate .

qud:A_Canticle_for_Barathrum a qud:Quest ;
    qud:requiresCompleting qud:A_Call_to_Arms,
        qud:Decoding_the_Signal,
        qud:More_Than_a_Willing_Spirit .

qud:Barathrum_the_Old a qud:Mutant,
        qud:NPC ;
    qud:hasRace qud:Fungi,
        qud:Robot,
        qud:Urshiib ;
    qud:isHabitantOf qud:Grit_Gate,
        qud:Omonporch,
        qud:Rainbow_Wood,
        qud:Starfarers_Quay .

qud:Decoding_the_Signal a qud:Quest ;
    qud:requiresCompleting qud:A_Call_to_Arms,
        qud:A_Canticle_for_Barathrum,
        qud:More_Than_a_Willing_Spirit,
        qud:The_Earl_of_Omonporch ;
    qud:takesPlaceIn qud:Temple_of_the_Rock .

