    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot">
        <rdfs:comment xml:lang="en">The kind of mechanical creatures that walk Qud, untouched by biological mutation.</rdfs:comment>
        <rdfs:label>Robot</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin">
        <rdfs:comment xml:lang="en">The lineage of unmutated humans, the True Kin, whom stable genotype supports cybernetic implants. They are incapable of mutating.</rdfs:comment>
        <rdfs:label>Truekin</rdfs:label>
    </rdf:Description>
