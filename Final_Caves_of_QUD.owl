<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#"
     xml:base="http://www.semanticweb.org/chris/ontologies/caverne-di-qud"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#containsSettlement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#containsSettlement">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#locatedInPlace"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
        <rdfs:comment xml:lang="en">Ties a wider place to a settlement nested within it, as Bethesda Susa encloses the Temple of the Rock. The inverse view is locatedInPlace.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#dislikedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#dislikedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#dislikes"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:comment xml:lang="en">Lists the factions that hold a character in low regard; their poor standing can flare into open hostility. The opposite relation is dislikes.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#dislikes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#dislikes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:comment xml:lang="en">Captures a faction&apos;s antipathy toward a character, expressed as a negative starting reputation that make diplomacy almost impossible. The inverse is dislikedBy.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#foughtIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#foughtIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#involvesFightWith"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Names the quests in which a faction is set against the player as an enemy to overcome. The inverse relation is involvesFightWith.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#giveQuest -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#giveQuest">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isGivenBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Marks the quests an NPC offers the player, often dealt out one after another along the spine of the main story. The inverse is isGivenBy.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasIndividual -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasIndividual">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasRace"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdfs:comment xml:lang="en">Points from a race to the characters who belong to it. The inverse is hasRace.</rdfs:comment>
        <rdfs:label>hasIndividual</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasInhabitant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasInhabitant">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isHabitantOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:comment xml:lang="en">Records the resident characters of a place or settlement, usually its named and notable dwellers. The inverse relation is isHabitantOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasMember">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#memberOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:comment xml:lang="en">Points from a faction to the characters who belong to it and share its allegiances. The inverse is memberOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasRace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasRace">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <rdfs:comment xml:lang="en">Links a character to the species they were born into.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hasRole">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isRoleOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role"/>
        <rdfs:comment xml:lang="en">Connects an NPC to the part they play, whether fighting or trading, along with the details that role carries. The inverse is isRoleOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:comment xml:lang="en">Expresses a standing enmity of one faction toward another, so that their members attack each other on sight wherever they meet.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hostsQuest -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#hostsQuest">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#takesPlaceIn"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Names the quests that take place within a given place or settlement. The inverse relation is takesPlaceIn.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#involvesFightWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#involvesFightWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:comment xml:lang="en">Lists the factions a quest calls on the player to fight. The inverse is foughtIn.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#involvesFinding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#involvesFinding">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isSearchTargetIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Names the items or characters a quest requires the player to track down or reach. The inverse is isSearchTargetIn.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isGivenBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isGivenBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:comment xml:lang="en">Identifies the NPC who entrusts a particular quest to the player. The inverse relation is giveQuest.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isHabitantOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isHabitantOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Names the place or settlement where an NPC makes their home. The inverse is hasInhabitant.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isRewardFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isRewardFor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#rewardsWith"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Marks the quest for which an item serves as the reward. The inverse relation is rewardsWith.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isRoleOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isRoleOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:comment xml:lang="en">Points from a role back to the NPC who fulfils it. The inverse is hasRole.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isSearchTargetIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#isSearchTargetIn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Marks the quest in which an item or character is the thing to be found. The inverse is involvesFinding.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#likedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#likedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#likes"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:comment xml:lang="en">Lists the factions that favour a character and will side with them.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#likes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#likes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:comment xml:lang="en">Captures a faction&apos;s fondness for a character, shown in-game as a positive starting reputation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#locatedInPlace -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#locatedInPlace">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <rdfs:comment xml:lang="en">Names the larger place that encloses a settlement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#memberOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#memberOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <rdfs:comment xml:lang="en">Names the factions an NPC belongs to, inheriting their friendships and feuds.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#requiresCompleting -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#requiresCompleting">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:comment xml:lang="en">Marks a quest that must be finished before the current one can begin, giving the main story its ordered progression.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#rewardsWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#rewardsWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <rdfs:comment xml:lang="en">Names the item granted to the player upon finishing a quest.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#sellsItem -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#sellsItem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <rdfs:comment xml:lang="en">Lists the goods a merchant keeps available for trade.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#spawnsIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#spawnsIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <rdfs:comment xml:lang="en">Names the place where the player character first appears at the start of the game.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#takesPlaceIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#takesPlaceIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Names the place or settlement where a quest unfolds.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Boss -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Boss">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A flag on a fighter that is true when the combatant is a unique boss, typically far tougher than common foes.</rdfs:comment>
        <rdfs:label>Boss</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#HP -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#HP">
        <rdfs:comment xml:lang="en">The maximum hitpoints of a character. In play it rises chiefly with Toughness and with each level gained.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tier -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>high</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>low</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>mid</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The market standing of a merchant, given as low, mid or high, indicating how rare and valuable the goods on offer at barter are likely to be.</rdfs:comment>
        <rdfs:label>Tier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Value -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Value">
        <rdfs:comment xml:lang="en">The commerce value of an item, reckoned in drams of fresh water, the universal currency that Qud&apos;s traders weigh every deal against.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weight">
        <rdfs:comment xml:lang="en">The weight of an item in game units, which adds to the load a character carries and so bears on how freely they can move and fight.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#level -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#level">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The level of a character, a shorthand for overall power that feeds into derived statistics such as hitpoints and the experience they yield.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#strata -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#strata">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The depth of a place or settlement below the surface, where zero is ground level; the deeper the strata, the harsher the threats that tend to lurk there.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Organic"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Any sentient being in the world of Qud, from wandering monsters to named legends and the player&apos;s own avatar. Characters are told apart both by their nature, biological or mechanical, and by the part they play in the story, whether they are driven by the game or by the player.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction">
        <rdfs:comment xml:lang="en">An organized group of Qud such as a guild, religious order, tribe or species, toward which the player holds a numeric reputation. Factions love or hate other characters and factions, and those feelings decide who turns hostile on sight and who offers aid.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader"/>
        <rdfs:comment xml:lang="en">A combatant whose purpose is to fight. Some are recruitable NPCs, while others are unique bosses guarding a location or a quest objective; the Boss flag marks which is which. Bosses tend to carry the highest combat stats in their region.</rdfs:comment>
        <rdfs:label>Fighter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item">
        <rdfs:comment xml:lang="en">A tangible object that can be picked up, carried, traded or earned from a quest. Each is measured by its weight and by its commerce value, which in Qud is reckoned in drams of fresh water, the currency that underpins all trade.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Organic"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin"/>
        <rdfs:comment xml:lang="en">A living creature reshaped by the mutations that pervade Qud, including mutated humans, sentient plants and fungi. In place of cybernetics, mutants develop physical and mental powers that grow stronger as they level, setting them apart from the unmutated True Kin.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter"/>
        <rdfs:comment xml:lang="en">A non-player character run by the game. An NPC may dwell in a place, belong to one or more factions, take on a combat or merchant role, and hand out quests, acting as the world&apos;s source of trade, lore and missions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Organic -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Organic">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot"/>
        <rdfs:comment xml:lang="en">A flesh-and-blood being, as opposed to the machines. Organic creatures rely on biology, so they are open to mutation and to infection, and they react to poison, disease and bleeding in ways the robots never do.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place">
        <rdfs:comment xml:lang="en">An explorable but unsettled location such as a ruined well, a tomb, a forest or a quay. Each lies at a certain depth below the surface and may shelter inhabitants and host quests, often guarding the dangers and rewards of the deep.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
        <rdfs:comment xml:lang="en">The avatar steered by the player through Qud. Their choices shape reputation, alliances and the eventual ending; everything from caste and mutations to the factions they court is theirs to decide.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest">
        <rdfs:comment xml:lang="en">A story or side mission woven into the main plot. Quests chain together as prerequisites, unfold at particular places, may require finding items or people or fighting whole factions, and usually grant a reward on completion.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race">
        <rdfs:comment xml:lang="en">The species or lineage a character belongs to, such as True Kin, urshiib or mollusk. Race shapes a creature&apos;s body and appearance and can set its starting mutations or its initial standing with the factions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Character"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The function an NPC fulfils in the world, either as a Fighter who does battle or as a Trader who deals in goods. A character&apos;s role carries its own details, such as whether a fighter is a boss or how rich a merchant&apos;s stock is.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement">
        <rdfs:comment xml:lang="en">An inhabited village or outpost set at a given depth, with its own resident characters and the quests they host. Settlements are the hubs where the player talks, trades and takes on missions between forays into the wilds.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Role"/>
        <rdfs:comment xml:lang="en">A merchant who offers goods in exchange for water or barter. The Tier (low, mid or high) reflects how deep the merchant&apos;s purse runs and how rare and valuable the wares they keep in stock.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin -->

    <owl:Class rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Organic"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFightWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <rdfs:comment xml:lang="en">The Putus Templar lay siege to Grit Gate in a battle where the player must hold the enclave alongside the Barathrumites. The fighting carries the real risk of allied NPCs dying for good.</rdfs:comment>
        <rdfs:label>A Call to Arms</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <rdfs:comment xml:lang="en">Having caught a strange repeating signal, Argyve sends the player to Grit Gate to consult Otho and Barathrum. It follows Weirdwire Conduit and serves as the player&apos;s introduction to the Barathrumites.</rdfs:comment>
        <rdfs:label>A Canticle for Barathrum</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutated_Human"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader_low"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">150</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</level>
        <rdfs:comment xml:lang="en">An aged mutant tinker of Joppa, a low-tier merchant and junior Barathrumite. He opens the story by building the Weirdwire Conduit and taking the player on as his apprentice.</rdfs:comment>
        <rdfs:label>Argyve</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Asphodel_Earl_of_Omonporch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Asphodel_Earl_of_Omonporch">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sentient_Plant"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</level>
        <rdfs:comment xml:lang="en">A vain sentient plant of the Consortium of Phyta, who has crowned itself Earl of Omonporch. Weak in a fight, it is shielded by twelve asphodelytes, its followers, whose electrical powers make any assault deadly.</rdfs:comment>
        <rdfs:label>Asphodel Earl of Omonporch</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Baetyl -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Baetyl">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2000</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</level>
        <rdfs:comment xml:lang="en">A robotic altar-being of the Temple of the Rock. It is the last functioning computer of its kind and it is revered as the &quot;House of God&quot; by the Mechanists</rdfs:comment>
        <rdfs:label>Baetyl</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <dislikedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume?"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Urshiib"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Seraphic_Covenant"/>
        <rdfs:comment xml:lang="en">The eldest and wisest urshiib in Qud and head of the Barathrumites, credited with inventing the Barathrum clock and the astrolabe. He hands out the endgame quests and conceals a hidden bond with the Seraphic Covenant.</rdfs:comment>
        <rdfs:label>Barathrum the Old</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golem"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <likes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <likes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <likes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Kun"/>
        <likes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <rdfs:comment xml:lang="en">A secretive guild of tinkers, mostly urshiib, hidden at the bottom of Grit Gate behind an army of chromelings and waydroids. Led by their namesake Barathrum the Old. At odds with the Mechanimists who refuse using technology</rdfs:comment>
        <rdfs:label>Barathrumites</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Bethesda_Susa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Bethesda_Susa">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <containsSettlement rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Saad_Amus"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#alchemist"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">A sprawling subterranean complex the Mechanimists hold sacred, enclosing the Temple of the Rock within its depths. The temperature gets lower the deeper it gets and holds various specimens in the cryogenic chambers</rdfs:comment>
        <rdfs:label>Bethesda Susa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Copper_Wire -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Copper_Wire">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</Weight>
        <rdfs:comment xml:lang="en">Strands of copper wire scattered through the Rust Wells. Although  Although rare, it hold value only in the hands of a tinker. Needed to build the weirdwire conduit</rdfs:comment>
        <rdfs:label>Copper Wire</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFightWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Baetyl"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Bethesda_Susa"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock"/>
        <rdfs:comment xml:lang="en">Otho sends the player into the depths of Bethesda Susa and the Temple of the Rock to decode the mysterious signal, clashing with the Mechanimists along the way.</rdfs:comment>
        <rdfs:label>Decoding the Signal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Eaters_Tomb -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Eaters_Tomb">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Herodododicus"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">The mausoleum of the Eaters, accessed from the Omonporchl. Grave robbers infest the once sacred place.</rdfs:comment>
        <rdfs:label>Eaters&apos; Tomb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter"/>
        <isRoleOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock"/>
        <isRoleOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Saad_Amus"/>
        <isRoleOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Slog_of_the_Cloaca"/>
        <isRoleOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon"/>
        <Boss rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</Boss>
        <rdfs:comment xml:lang="en">The boss fighter role: a unique, high-level combatant set apart from common foes.</rdfs:comment>
        <rdfs:label>Fighter (Boss=True)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_NonBoss -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_NonBoss">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter"/>
        <isRoleOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golem"/>
        <Boss rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</Boss>
        <rdfs:comment xml:lang="en">The non-boss fighter role: a capable combatant who is not a unique boss enemy.</rdfs:comment>
        <rdfs:label>Fighter (Boss=False)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fungi -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fungi">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq"/>
        <rdfs:comment xml:lang="en">Sentient fungi that spread by spore and infection across Qud.</rdfs:comment>
        <rdfs:label>Fungi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <dislikes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Kun"/>
        <foughtIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Villagers_of_Joppa"/>
        <rdfs:comment xml:lang="en">Faction of various monsters which objective is to devour everything that moves. They are an existential threat to Qud&apos;s sentient life. Their slumbering Nephilim are among the great threats of the endgame. Beating them is necessary to save Qud.</rdfs:comment>
        <rdfs:label>Girsh</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh_Nephilim -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh_Nephilim">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon"/>
        <rdfs:comment xml:lang="en">The Girsh Nephilim are creatures of the seventh plague upon Qud. There are seven known Nephilim, the strongest being Starformed Ehalcodon. Once put to sleep by Reseph, they awake after a thousand-year-long sleep</rdfs:comment>
        <rdfs:label>Girsh Nephilim</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golem -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golem">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_NonBoss"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">350</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</level>
        <rdfs:comment xml:lang="en">A colossus built by the Barathrumites. It is the vessel by which the player ascends to Starfarers&apos; Quay</rdfs:comment>
        <rdfs:label>Golem</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golgotha -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golgotha">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Slog_of_the_Cloaca"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">A multi-level refuse pit choked with trash, sewage and deadly creatures, descending to the fetid Cloaca at its bottom. It serves as the Barathrumites&apos; trial: here the player recovers a scrapped waydroid under the shadow of Slog.</rdfs:comment>
        <rdfs:label>Golgotha</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golem"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</strata>
        <rdfs:comment xml:lang="en">A fortified Barathrumite outpost beneath an arch of jungle-strangled ruins. The heart of the enclave where Otho, Barathrum and the other barathrumites reside, it is where the main questline takes root.</rdfs:comment>
        <rdfs:label>Grit Gate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Herodododicus -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Herodododicus">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Eaters_Tomb"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">150</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</level>
        <rdfs:comment xml:lang="en">The robotic keeper of the Eaters&apos; Tomb, found beside Resheph&apos;s empty sarcophagus. He is bound up with the rite of entombment that grants acces to Brightsheol, a console that controls acces to Starfarers&apos; Quay by modulating the magnetic field</rdfs:comment>
        <rdfs:label>Herodododicus</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">The starting village on the surface, raised on stilts amid fields of watervine. Home to the tinker Argyve and the launch point for the player, it is the first safe haven a new wanderer comes to know.</rdfs:comment>
        <rdfs:label>Joppa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa_Recoiler -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa_Recoiler">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isRewardFor rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Weight>
        <rdfs:comment xml:lang="en">A recoiler that whisks its bearer back to Joppa when triggered, so long as a charged power cell sits inside and no enemy blocks the way. Awarded by Argyve for the first quest</rdfs:comment>
        <rdfs:label>Joppa Recoiler</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Kun -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Kun">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#PlayerCharacter"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin"/>
        <dislikedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <dislikedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <spawnsIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa"/>
        <rdfs:comment xml:lang="en">One of the possible player character preset. a True Kin who sets out from Joppa.</rdfs:comment>
        <rdfs:label>Kun</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <foughtIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock"/>
        <likes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph"/>
        <rdfs:comment xml:lang="en">A religious order that holds technology itself to be sacred and worships the six Argent Fathers, foremost among them Shekhinah, but also including Reseph. They deem artifacts holy relics unfit for mortal hands, and a breakaway branch venerates the baetyls deep within Bethesda Susa instead.</rdfs:comment>
        <rdfs:label>Mechanimists</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mollusk -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mollusk">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Slog_of_the_Cloaca"/>
        <rdfs:comment xml:lang="en">Giant sentient molluscs of the underground waters, sluggish but immensely strong. Slog of the Cloaca, overlord of the Cloaca in Golgotha, is one of their number.</rdfs:comment>
        <rdfs:label>Mollusk</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Scrapped_Waydroid"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum"/>
        <rewardsWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile_s_Carbine"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golgotha"/>
        <rdfs:comment xml:lang="en">The Barathrumites&apos; rite of passage: descend the death-pit of Golgotha, recover a scrapped waydroid and repair it while eluding or facing Slog. The reward is Sparafucile&apos;s Carbine and access to the Barathrumites&apos; settlement</rdfs:comment>
        <rdfs:label>More Than a Willing Spirit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutated_Human -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutated_Human">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#alchemist"/>
        <rdfs:comment xml:lang="en">Humans touched by the mutations of Qud, granted physical or mental powers. They are a playable lineage and the most common kind of mutant met across the world.</rdfs:comment>
        <rdfs:label>Mutated Human</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Asphodel_Earl_of_Omonporch"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">The base of the Spindle amid banana groves, holding the Court of the Sultans and the Arcade to the Twin Gates that lead into the Tomb of the Eaters. It is ruled by the self-styled Earl Asphodel.</rdfs:comment>
        <rdfs:label>Omonporch</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit"/>
        <giveQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Urshiib"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Canticle_for_Barathrum"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</level>
        <rdfs:comment xml:lang="en">The urshiib steward of Grit Gate and Barathrum&apos;s stern second-in-command. He is the first great quest-giver of the main story.</rdfs:comment>
        <rdfs:label>Otho</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fungi"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rainbow_Wood"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume?"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">300</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</level>
        <rdfs:comment xml:lang="en">The only unique member of the fungi faction, hailed by Barathrum as an eccentric mushroom prodigy and a brilliant scientist and engineer. It lives in a hut of mushroom flesh in the Rainbow Wood</rdfs:comment>
        <rdfs:label>Pax Qlanq</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutated_Human"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">225</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</level>
        <rdfs:comment xml:lang="en">The High Priest of the Mechanimist branch within Bethesda Susa, a boss who no longer recognizes the authority of Eschelstadt II. He leads the faithful of the Temple of the Rock.</rdfs:comment>
        <rdfs:label>Phinae Hoshaiah High Priest of the Rock</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <dislikes rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Kun"/>
        <foughtIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms"/>
        <foughtIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <rdfs:comment xml:lang="en">A militant order of True Kin purists who loathe every mutant and reserve a special hatred for Barathrum, whom they see as a living rebuke to their creed. They storm Grit Gate and are fought in both A Call to Arms and Reclamation.</rdfs:comment>
        <rdfs:label>Putus Templar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rainbow_Wood -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rainbow_Wood">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume?"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">A wood of shifting colours filled with slimes and fungi. At its heart grows the Eater&apos;s flesh, a fungus that, once eaten, reveals the hidden path to Pax Qlanq&apos;s mushroom-flesh hut.</rdfs:comment>
        <rdfs:label>Rainbow Wood</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFightWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <involvesFightWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Putus_Templar"/>
        <involvesFightWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch"/>
        <rdfs:comment xml:lang="en">An endgame quest to secure the Spindlegrounds of Omonporch by repelling the Putus Templar and facing Starformed Ehalcodon. .</rdfs:comment>
        <rdfs:label>Reclamation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starfarers_Quay"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight"/>
        <likedBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mechanimists"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Seraphic_Covenant"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4000</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</level>
        <rdfs:comment xml:lang="en">The seraph known as the Above, a machine-mind within the Seraphic Covenant, remembered as the last Sultan of Qud. From the star-port of Starfarers&apos; Quay he schemes to till the noosphere of all sentient life using the Girsh</rdfs:comment>
        <rdfs:label>Reseph</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Robot">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rust_Wells -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rust_Wells">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</strata>
        <rdfs:comment xml:lang="en">Crater-like red wells brimming with scrap metal, east of Joppa and threaded with strands of copper wire. The player gathers copper wire here for the opening quest</rdfs:comment>
        <rdfs:label>Rust Wells</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Saad_Amus -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Saad_Amus">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Truekin"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Bethesda_Susa"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">350</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</level>
        <rdfs:comment xml:lang="en">A legendary True Kin warrior cryogenically frozen in Bethesda Susa. If awaken from his chiliad sleep he will become immediately hostile to the player</rdfs:comment>
        <rdfs:label>Saad Amus</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Scrapped_Waydroid -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Scrapped_Waydroid">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Weight>
        <rdfs:comment xml:lang="en">The metallic husk of a defunct waydroid, stripped of its copper wire, LED lights and chrome bearings. Found in the Cloaca, it can be repaired into a dormant waydroid to fulfil More Than a Willing Spirit.</rdfs:comment>
        <rdfs:label>Scrapped Waydroid</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sentient_Plant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sentient_Plant">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Race"/>
        <hasIndividual rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Asphodel_Earl_of_Omonporch"/>
        <rdfs:comment xml:lang="en">Speaking, scheming plants of the Consortium of Phyta, as capable of politics as of photosynthesis. The vainglorious Earl Asphodel springs from this stock.</rdfs:comment>
        <rdfs:label>Sentient Plant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Seraphic_Covenant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Seraphic_Covenant">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Faction"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <hasMember rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph"/>
        <rdfs:comment xml:lang="en">A covenant bound to the seraphim, orbiting machine-minds orphaned when their Coven abandoned Qud. Reseph, the seraph called the Above, and secretly Barathrum are tied to it, and its purpose is to preserve Qud&apos;s life forms</rdfs:comment>
        <rdfs:label>Seraphic Covenant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Slog_of_the_Cloaca -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Slog_of_the_Cloaca">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mollusk"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Golgotha"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">150</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</level>
        <rdfs:comment xml:lang="en">A colossal mollusc that lords over the Cloaca of Golgotha, a legendary boss who spews toxic ooze and crushes its prey beneath its bulk.</rdfs:comment>
        <rdfs:label>Slog of the Cloaca</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Urshiib"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Trader_mid"/>
        <isHabitantOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrumites"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</level>
        <rdfs:comment xml:lang="en">An urshiib tinker of Grit Gate, a mid-tier merchant and Barathrumite who keeps the hidden enclave supplied with gear beneath the arch.</rdfs:comment>
        <rdfs:label>Sparafucile</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile_s_Carbine -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Sparafucile_s_Carbine">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isRewardFor rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#More_Than_a_Willing_Spirit"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</Weight>
        <rdfs:comment xml:lang="en">A finely made carbine once carried by Sparafucile, weighing 10 and worth 200. It is the reward for completing More Than a Willing Spirit.</rdfs:comment>
        <rdfs:label>Sparafucile&apos;s Carbine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starfarers_Quay -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starfarers_Quay">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Place"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</strata>
        <rdfs:comment xml:lang="en">A star-port founded by Reseph to receive visitors from across the cosmos, where the ship Exodus lies docked. It is the stage of the quest We Are Starfreight and one of the doorways to the game&apos;s several endings.</rdfs:comment>
        <rdfs:label>Starfarers&apos; Quay</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starformed_Ehalcodon">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#NPC"/>
        <foughtIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <hasRace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh_Nephilim"/>
        <hasRole rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Fighter_Boss"/>
        <memberOf rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12000</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</level>
        <rdfs:comment xml:lang="en">A star-forged Girsh boss that can be faced during Reclamation by slaying the other six Girsh. Whether it lives or dies opens alternative conversations in the game&apos;s epilogue.</rdfs:comment>
        <rdfs:label>Starformed Ehalcodon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Temple_of_the_Rock">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Settlement"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Baetyl"/>
        <hasInhabitant rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Phinae_Hoshaiah_High_Priest_of_the_Rock"/>
        <hostsQuest rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <locatedInPlace rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Bethesda_Susa"/>
        <strata rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</strata>
        <rdfs:comment xml:lang="en">A Mechanimist temple set far underground within Bethesda Susa and led by Phinae Hoshaiah. Its breakaway congregation holds the site holy and no longer answers to the High Priest of the distant Six Day Stilt.</rdfs:comment>
        <rdfs:label>Temple of the Rock</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Earl_of_Omonporch">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Asphodel_Earl_of_Omonporch"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Otho"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Decoding_the_Signal"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch"/>
        <rdfs:comment xml:lang="en">Otho charges the player to secure the lease of the Spindle from Asphodel at Omonporch, either by convening a council of allied factions or by striking the self-appointed Earl down.</rdfs:comment>
        <rdfs:label>The Earl of Omonporch</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#neutron_flux"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Grit_Gate"/>
        <rdfs:comment xml:lang="en">Barathrum tasks the player with gathering ingredients, neutron flux among them, to construct the Golem. The reward is the Golem itself, the means of ascending the Spindle to reach Starfarers&apos; Quay</rdfs:comment>
        <rdfs:label>The Golem</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters -->

