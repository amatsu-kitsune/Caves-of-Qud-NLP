        <isRewardFor rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Tomb_of_the_Eaters"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">600</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Weight>
        <rdfs:comment xml:lang="en">A rare applicator from Barathrum&apos;s own collection that makes a single exact duplicate of an inventory item before being used up.</rdfs:comment>
        <rdfs:label>metamorphic polygel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#neutron_flux -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#neutron_flux">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isSearchTargetIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#The_Golem"/>
        <Value rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</Value>
        <Weight rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</Weight>
        <rdfs:comment xml:lang="en">An exceedingly rare and volatile liquid that detonates with shattering force ( equal to  the weight of a thousand suns) at almost any handling. Incredibly pricy too.</rdfs:comment>
        <rdfs:label>neutron flux</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#quantum_mote -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#quantum_mote">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Item"/>
        <isRewardFor rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume?"/>
        <rdfs:comment xml:lang="en">A high-tier floating light source that drifts around its bearer, granting strong resistance to acid, cold, electricity and heat and a bonus to all saving throws. Barathrum gives one to the player after Pax Qlanq, I Presume?.</rdfs:comment>
        <rdfs:label>quantum mote</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume? -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq_I_Presume?">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Pax_Qlanq"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#A_Call_to_Arms"/>
        <rewardsWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#quantum_mote"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rainbow_Wood"/>
        <rdfs:comment xml:lang="en">Barathrum asks the player to carry the golem climber blueprints to Pax Qlanq and ask him to build it, deep in the Rainbow Wood and reachable only after eating the Eater&apos;s flesh. The reward is a quantum mote.</rdfs:comment>
        <rdfs:label>Pax Qlanq, I Presume?</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka! -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Weirdwire_Conduit_Eureka!">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Copper_Wire"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Argyve"/>
        <rewardsWith rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Joppa_Recoiler"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Rust_Wells"/>
        <rdfs:comment xml:lang="en">The opening quest from Argyve: gather at least 200 feet of copper wire from the Rust Wells and bring it back to build the Weirdwire Conduit. Its reward is a Joppa recoiler and a foothold in the main story.</rdfs:comment>
        <rdfs:label>Weirdwire Conduit... Eureka!</rdfs:label>
    </owl:NamedIndividual>
    


