        <HP rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">175</HP>
        <level rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</level>
        <rdfs:comment xml:lang="en">A high-tier mutant merchant in the Ruined Ward of Bethesda Susa, the one guaranteed seller of neutron flux and a wide array of phials. Speaking with the alchemist for the first time unlocks an achievement. If threatened he will detonate the neutron flux.</rdfs:comment>
        <rdfs:label>alchemist</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#metamorphic_polygel -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#metamorphic_polygel">
