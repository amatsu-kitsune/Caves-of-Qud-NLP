        <rdfs:comment xml:lang="en">Albino mutant bears clad in quills and blessed with triple-jointed limbs. They are the reclusive tinkers of the Barathrumites, dwelling far below the arch of Grit Gate.</rdfs:comment>
        <rdfs:label>Urshiib</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Villagers_of_Joppa -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Villagers_of_Joppa">
