        <hates rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Girsh"/>
        <rdfs:comment xml:lang="en">The peaceful farmers of Joppa, the starting village, who tend their watervine along the river. They welcome the fledgling adventurer and stand as the first friendly community of the journey.</rdfs:comment>
        <rdfs:label>Villagers of Joppa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#We_Are_Starfreight">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Quest"/>
        <involvesFinding rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reseph"/>
        <isGivenBy rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Barathrum_the_Old"/>
        <requiresCompleting rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Reclamation"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Omonporch"/>
        <takesPlaceIn rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Starfarers_Quay"/>
        <rdfs:comment xml:lang="en">The closing quest: reach Reseph at Starfarers&apos; Quay. It leads to the game&apos;s ending, where the  player forges a covenant with the seraph to evolve Qud&apos;s sentient life</rdfs:comment>
        <rdfs:label>We Are Starfreight</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/chris/ontologies/caverne-di-qud#alchemist -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#alchemist">
        <rdf:type rdf:resource="http://www.semanticweb.org/chris/ontologies/caverne-di-qud#Mutant"/>
